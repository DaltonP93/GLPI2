# WhatsApp Adapter — variables de entorno de ejemplo.
# Copiar a .env (ignorado por Git). NO colocar secretos reales aquí.
SERVICE_NAME=whatsapp-adapter
SERVICE_PORT=8090
LOG_LEVEL=info

# Acceso a GLPI (API REST v2) con token de mínimo privilegio.
GLPI_API_URL=http://glpi/apirest.php
GLPI_APP_TOKEN=__CHANGE_ME__
GLPI_USER_TOKEN=__CHANGE_ME__

# Trazabilidad
CORRELATION_ID_HEADER=X-Correlation-Id
TZ=America/Asuncion

{% extends "layout/page_without_tabs.html.twig" %}

{% block content_title %}{{ title }}{% endblock %}

{% block content_body %}
   {{ include('@companypurchasing/parts/nav.html.twig') }}

   <form method="post" action="{{ base }}/config/save" class="card mb-3">
      <div class="card-header"><h3 class="card-title">{{ __('Approval stages', 'companypurchasing') }}</h3></div>
      <div class="card-body row g-3">
         {% for suffix, g in groups %}
            <div class="col-md-4">
               <label class="form-label">{{ g.label }} — {{ __('Approver group', 'companypurchasing') }}</label>
               {{ g.dropdown|raw }}
               <label class="form-label mt-2">{{ __('Quorum', 'companypurchasing') }}</label>
               <input class="form-control" name="quorum_{{ suffix }}" inputmode="numeric" value="{{ values['quorum_' ~ suffix] }}">
               <label class="form-label mt-2">{{ __('SLA (hours, empty = none)', 'companypurchasing') }}</label>
               <input class="form-control" name="sla_hours_{{ suffix }}" inputmode="numeric" value="{{ values['sla_hours_' ~ suffix] }}">
            </div>
         {% endfor %}
      </div>
      <div class="card-header"><h3 class="card-title">{{ __('Purchasing and costs', 'companypurchasing') }}</h3></div>
      <div class="card-body row g-3">
         <div class="col-md-3"><label class="form-label">{{ __('Default currency', 'companypurchasing') }}</label><input class="form-control" name="default_currency" maxlength="3" value="{{ values.default_currency }}"></div>
         {% for key, label in {'cost_include_discounts': __('Include discounts in unit cost', 'companypurchasing'), 'cost_include_taxes': __('Include taxes in unit cost', 'companypurchasing'), 'cost_include_freight': __('Include freight in unit cost', 'companypurchasing'), 'notifications_enabled': __('Send native notifications', 'companypurchasing'), 'sync_on_workflow_events': __('Project workflow state immediately', 'companypurchasing')} %}
            <div class="col-md-3 form-check mt-4"><input class="form-check-input" type="checkbox" name="{{ key }}" value="1" {{ values[key] == '1' ? 'checked' : '' }}><label class="form-check-label">{{ label }}</label></div>
         {% endfor %}
      </div>
      <div class="card-header"><h3 class="card-title">{{ __('Operational limits', 'companypurchasing') }}</h3></div>
      <div class="card-body row g-3">
         {% for key, label in {'receipt_max_units_per_batch': __('Max units per reception', 'companypurchasing'), 'delivery_max_units_per_batch': __('Max units per delivery', 'companypurchasing'), 'outbox_max_attempts': __('Max inventory handoff attempts', 'companypurchasing'), 'outbox_max_lease_seconds': __('Max inventory handoff lease (seconds)', 'companypurchasing'), 'inbox_scan_cap': __('Inbox scan limit', 'companypurchasing'), 'metrics_max_requests': __('Metrics: max requests for stage durations', 'companypurchasing')} %}
            <div class="col-md-4"><label class="form-label">{{ label }}</label><input class="form-control" name="{{ key }}" inputmode="numeric" value="{{ values[key] }}"></div>
         {% endfor %}
      </div>
      <div class="card-footer">
         {{ include('@companypurchasing/parts/csrf.html.twig') }}
         <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'companypurchasing') }}</button>
      </div>
   </form>

   <form method="post" action="{{ base }}/config/publish" class="card">
      <div class="card-body d-flex justify-content-between align-items-center">
         <div>
            {% if definition is not null %}
               {{ __('Active workflow definition version', 'companypurchasing') }}: <strong>{{ definition.version }}</strong>
            {% else %}
               <span class="text-warning">{{ __('No workflow definition published yet', 'companypurchasing') }}</span>
            {% endif %}
            <div class="small text-muted">{{ __('Publishing creates a NEW version; existing requests keep the version they started with.', 'companypurchasing') }}</div>
         </div>
         {{ include('@companypurchasing/parts/csrf.html.twig') }}
         <button class="btn btn-warning" type="submit"><i class="ti ti-upload me-1"></i>{{ __('Publish workflow definition', 'companypurchasing') }}</button>
      </div>
   </form>
{% endblock %}

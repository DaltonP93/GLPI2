# =====================================================================
# .env.example  -  Plataforma GLPI Modular
# COPIAR a .env y completar con valores locales. NO subir .env a Git.
# NO colocar credenciales reales en este archivo de ejemplo.
# =====================================================================

# ---- Versión oficial de GLPI (dependencia upstream, estable) ----
GLPI_VERSION=11.0.8

# ---- Localización (obligatoria por CLAUDE.md) ----
GLPI_LANGUAGE=es_ES
GLPI_TIMEZONE=America/Asuncion
GLPI_DEFAULT_CURRENCY=PYG

# ---- Base de datos (separada, propia del stack) ----
MARIADB_HOST=db
MARIADB_PORT=3306
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
# Definir en .env real / secret manager. Placeholder no funcional:
MARIADB_PASSWORD=__CHANGE_ME__
MARIADB_ROOT_PASSWORD=__CHANGE_ME__

# ---- Correo (dev usa MailHog; prod usa SMTP real por secret manager) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.local

# ---- Timezone del contenedor / PHP ----
TZ=America/Asuncion
PHP_MEMORY_LIMIT=256M

# ---- Puertos publicados en host (dev) ----
HTTP_PORT=8080
MAILHOG_UI_PORT=8025

# ---- Cron ----
GLPI_CRON_INTERVAL=60

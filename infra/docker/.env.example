# =====================================================================
# infra/docker/.env.example — variables del stack Docker Compose.
# Copiar a infra/docker/.env (ignorado por Git) y completar.
# NO colocar credenciales reales en este archivo de ejemplo.
# =====================================================================

# Versión oficial estable de GLPI (dependencia upstream).
GLPI_VERSION=11.0.8

# Localización
TZ=America/Asuncion

# Base de datos (MariaDB) — definir contraseñas reales sólo en .env.
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD=__CHANGE_ME__
MARIADB_ROOT_PASSWORD=__CHANGE_ME__

# Puertos publicados en el host
HTTP_PORT=8080
MAILHOG_UI_PORT=8025

# PHP / Cron
PHP_MEMORY_LIMIT=256M
GLPI_CRON_INTERVAL=60

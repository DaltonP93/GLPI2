files/
marketplace/
/config/
*.sql
*.sql.gz
backups/
_backups/

# ---- Dependencias ----
vendor/
node_modules/
composer.lock
package-lock.json

# ---- Logs / temporales ----
*.log
logs/
tmp/
.cache/

